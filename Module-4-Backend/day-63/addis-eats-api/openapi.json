  "info": {
    "title": "Addis Eats API",
    "description": "API for browsing Addis Eats restaurants and managing delivery orders. Requests require the configured x-api-key header; request processing is limited to five seconds.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "string"
          },
          "area": {
            "type": "string",
            "enum": [
              "Bole",
              "Kazanchis",
              "Piassa",
              "CMC"
            ]
          },
          "totalSantim": {
            "type": "number",
            "minimum": 1
          },
          "phone": {
            "type": "string",
            "pattern": "^(?:\\+251|0)9\\d{8}$"
          }
        },
        "required": [
          "customer",
          "area",
          "totalSantim"
        ]
      },
      "CreateRestaurantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "area": {
            "type": "string",
            "enum": [
              "Bole",
              "Kazanchis",
              "Piassa",
              "CMC"
            ]
          },
          "isOpen": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "area"
        ]
      }
    }
  }
}